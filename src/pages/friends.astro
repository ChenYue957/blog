---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="友链">
    <div class="card-base p-6 md:p-8">
        <div class="flex items-center gap-2 mb-6">
            <div class="h-8 w-8 rounded-lg bg-[var(--primary)] flex items-center justify-center text-white dark:text-black/70">
                <Icon name="material-symbols:diversity-3" class="text-[1.5rem]">
            </div>
            <h1 class="text-2xl font-bold text-black dark:text-white">友链</h1>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="https://surfissh.github.io/reservation/" target="_blank" class="friend-card">
                <div class="flex items-center gap-2">
                    <img src="https://surfissh.github.io/reservation/surfish.svg" loading="lazy" class="w-5 h-5 rounded">
                    <div class="font-bold text-black dark:text-white">睿睿子</div>
                </div>
                <div class="text-sm text-black/50 dark:text-white/50">一位从小学相识到现在的好友</div>
            </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="https://pluxzronin.github.io/Yongde_SaMa-webdesign.github.io/" target="_blank" class="friend-card">
                <div class="flex items-center gap-2">
                    <img src="https://chenyue957.github.io/home/static/img/yongde_sama.png" loading="lazy" class="w-5 h-5 rounded">
                    <div class="font-bold text-black dark:text-white">Ronin Yongde_sama</div>
                </div>
                <div class="text-sm text-black/50 dark:text-white/50">一位从初中结识到现在的挚友</div>
            </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="https://www.melodify.cn" target="_blank" class="friend-card">
                <div class="flex items-center gap-2">
                    <img src="https://www.melodify.cn/favicon.ico" loading="lazy" class="w-5 h-5 rounded">
                    <div class="font-bold text-black dark:text-white">忘却的旋律</div>
                </div>
                <div class="text-sm text-black/50 dark:text-white/50">一位偶然认识的朋友</div>
            </a>
        </div>
    </div>

</MainGridLayout>

<style>
.friend-card {
    @apply flex flex-col gap-1 p-4 rounded-lg bg-[var(--card-bg)] hover:bg-black/5 dark:hover:bg-white/5 transition;
}
</style>
